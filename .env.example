# Google Cloud Execution & Quota Project
GCP_PROJECT_ID=your-gcp-project-id

# Optional Service Account Key File (leave empty to use Application Default Credentials / ADC)
# GCP_KEY_FILE_PATH=./google-service-account.json

# BigQuery Allowlist Configuration (comma-separated table names in project.dataset.table or dataset.table format)
ALLOWLIST_TABLES=bigquery-public-data.chicago_taxi_trips.taxi_trips

# Query Safety Limits
MAX_BYTES_BILLED=10737418240
ROW_LIMIT=1000
