{
  "name": "custom-bigquery-mcp",
  "version": "1.0.0",
  "description": "Standalone Model Context Protocol (MCP) server for Google Cloud BigQuery with strict FinOps guardrails",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "custom-bigquery-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc -w",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bigquery",
    "google-cloud",
    "finops"
  ],
  "author": "Muhammad Iqbal Ghozy",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/bigquery": "^8.3.1",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
